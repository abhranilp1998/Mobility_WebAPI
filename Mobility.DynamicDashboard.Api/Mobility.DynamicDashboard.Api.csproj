<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enables local user-secrets storage for database credentials without committing them. -->
    <UserSecretsId>9f8f8e3f-3c37-4f5d-bb92-5c0d6ad91a67</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Dapper remains in the complete repository snapshot but is intentionally
      unused during this in-memory phase; no SQL/ASMX handler is registered.
    -->
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <!--
      Microsoft.AspNetCore.OpenApi generates the JSON contract but does not
      include an interactive HTML page. This UI-only package renders that
      existing JSON as the endpoint list and "Try it out" screen at /swagger.
    -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.0" />
  </ItemGroup>

</Project>
