<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enables local user-secrets storage for database credentials without committing them. -->
    <UserSecretsId>9f8f8e3f-3c37-4f5d-bb92-5c0d6ad91a67</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Dapper remains in the complete repository snapshot but is intentionally
      unused during this in-memory phase; no SQL/ASMX handler is registered.
    -->
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <!--
      Microsoft.AspNetCore.OpenApi generates the JSON contract but does not
      include an interactive HTML page. This UI-only package renders that
      existing JSON as the endpoint list and "Try it out" screen at /swagger.
    -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.0" />
  </ItemGroup>

  <!--
    A normal Rider/dotnet publish must be deployable as-is. The ignored local
    server settings file contains the real connection value and is required at
    publish time. Copy every project-local appsettings file unchanged after the
    Web SDK has completed its normal publish pipeline.
  -->
  <Target Name="RequireServerSettingsForPublish" BeforeTargets="Publish">
    <Error
      Condition="!Exists('$(MSBuildProjectDirectory)/appsettings.Server.json')"
      Text="Publishing requires Mobility.DynamicDashboard.Api/appsettings.Server.json. Restore the local server settings file before publishing." />
  </Target>

  <Target Name="PreserveAppSettingsInPublish"
          AfterTargets="Publish"
          DependsOnTargets="RequireServerSettingsForPublish">
    <ItemGroup>
      <AppSettingsToPreserve Include="$(MSBuildProjectDirectory)/appsettings*.json" />
    </ItemGroup>
    <Copy
      SourceFiles="@(AppSettingsToPreserve)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="false" />
  </Target>

</Project>
