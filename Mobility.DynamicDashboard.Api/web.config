<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore"
             path="*"
             verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>
      <!--
        This deployment currently uses the explicitly enabled Development
        authentication handler because the workplace has no HTTPS/JWT issuer.
        Keeping the environment here prevents a fresh IIS publish from silently
        reverting to Production and failing startup before definitions load.
      -->
      <aspNetCore processPath=".\Mobility.DynamicDashboard.Api.exe"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT"
                               value="Development" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
